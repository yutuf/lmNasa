# Local secrets for `npm run dev`. Copy to web/.env.local (git-ignored).
# Leave a value blank to use the offline fallback. Never commit real keys.

# Ask Luna (Gemini). Without this, Luna uses the built-in guide.
GEMINI_API_KEY=
# Optional. Default is gemini-2.5-flash.
GEMINI_MODEL=

# Read-aloud (ElevenLabs). Without this, the app uses the browser voice.
ELEVENLABS_API_KEY=
# Optional. Blank uses Sarah (EXAVITQu4vr4xnSDxMaL), a built-in voice every plan can use. Any voice id from your
# ElevenLabs account works (Voices -> ... -> Copy voice ID).
ELEVENLABS_VOICE_ID=
# Optional. Used for Turkish when set. Blank keeps the voice above (the multilingual model speaks Turkish).
ELEVENLABS_VOICE_ID_TR=

{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/v1/index.ts": {
      "maxDuration": 10
    },
    "api/v1/site.ts": {
      "maxDuration": 10,
      "includeFiles": "public/data/{manifest.json,atlas.bin,global_atlas.bin,ephem.bin,dsn.bin,hazard.bin}"
    },
    "api/v1/search.ts": {
      "maxDuration": 10,
      "includeFiles": "public/data/{manifest.json,atlas.bin,ephem.bin,dsn.bin,hazard.bin}"
    },
    "api/v1/sky.ts": {
      "maxDuration": 10,
      "includeFiles": "public/data/{manifest.json,atlas.bin,global_atlas.bin,ephem.bin,dsn.bin,hazard.bin}"
    }
  }
}

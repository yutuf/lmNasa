// LunaNav horizon compass: replays a site's Sun and Earth directions on the LED ring.
//
// Board: ESP32-C3-DevKitM-1 (Arduino core), library: Adafruit NeoPixel.
// track.h is generated by scripts/export_compass_track.py from LunaNav's precomputed series.
// NOT YET RUN ON HARDWARE: written against the board layout in this folder.

#include <Adafruit_NeoPixel.h>
#include "track.h"

const uint8_t LED_PIN = 10;       // GPIO10 -> R1 -> D1 (see generate_board.py; verify the devkit pinout)
const uint16_t FRAME_MS = 80;     // one hour of mission time per frame: a 30-day window plays in ~58 s
const uint8_t MAX_LEVEL = 60;     // of 255: keeps the ring well inside what USB can supply

Adafruit_NeoPixel ring(TRACK_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

void setup() {
  ring.begin();
  ring.clear();
  ring.show();
}

void loop() {
  static uint16_t hour = 0;

  uint8_t red[TRACK_LEDS] = {0}, green[TRACK_LEDS] = {0}, blue[TRACK_LEDS] = {0};

  // Sun: yellow, brightness = visible fraction of the solar disk above the terrain.
  uint8_t sun = (uint16_t)SUN_LEVEL[hour] * MAX_LEVEL / 255;
  red[SUN_LED[hour]] = sun;
  green[SUN_LED[hour]] = (uint16_t)sun * 7 / 10;

  // Earth: blue while its centre is above the terrain (direct-to-Earth link possible).
  if (EARTH_ON[hour]) {
    blue[EARTH_LED[hour]] = MAX_LEVEL;
  }

  for (uint8_t i = 0; i < TRACK_LEDS; i++) {
    ring.setPixelColor(i, ring.Color(red[i], green[i], blue[i]));
  }
  ring.show();

  hour = (hour + 1) % TRACK_HOURS;
  delay(FRAME_MS);
}

// LunaNav timeline bar: three rows of 28 LEDs, one row per landing spot, one LED per Earth day.
// Each LED mixes yellow (share of the day with the Sun up) and blue (share with Earth in view).
//
// Library: Adafruit NeoPixel. track.h is generated by scripts/export_timeline_track.py and is
// already in LED chain order (row A left to right, row B right to left, row C left to right).
// NEVER COMPILED AND NEVER RUN ON HARDWARE: written against the board layout in this folder.

#include <Adafruit_NeoPixel.h>
#include "track.h"

const uint8_t LED_PIN = 10;   // controller pin wired to J1 pin 2 (DIN); change to suit the controller
// Brightness cap, of 255, applied to every colour channel. Do not raise it: 84 LEDs with all three
// channels at 46/255 draw about 0.99 A (84 x 60 mA x 46/255 + 84 x 1 mA idle); 47 already exceeds 1 A.
const uint8_t MAX_LEVEL = 46;

Adafruit_NeoPixel bar(TRACK_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

void setup() {
  bar.begin();
  bar.clear();
  for (uint16_t i = 0; i < TRACK_LEDS; i++) {
    uint8_t sun = (uint16_t)SUN_SHARE[i] * MAX_LEVEL / 255;       // yellow = red + green
    uint8_t earth = (uint16_t)EARTH_SHARE[i] * MAX_LEVEL / 255;   // blue
    bar.setPixelColor(i, bar.Color(sun, sun, earth));
  }
  bar.show();
}

void loop() {
  // The picture is static: nothing to do.
}
